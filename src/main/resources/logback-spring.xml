<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    
    <!-- Property for correlation ID pattern -->
    <property name="CORRELATION_PATTERN" value="%X{correlationId:--}"/>
    
    <!-- CONSOLE APPENDER for LOCAL/DEV (Human-Readable) -->
    <appender name="CONSOLE_PLAIN" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{correlationId:-NO-CORRELATION-ID}] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>
    
    <!-- CONSOLE APPENDER for PROD (JSON Structured) -->
    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <timeZone>UTC</timeZone>
            <!-- Include MDC fields (like correlationId) in JSON output -->
            <includeMdc>true</includeMdc>
            <includeMdcKeyName>mdc</includeMdcKeyName>
        </encoder>
    </appender>


    <!-- FILE APPENDER for LOCAL/DEV (Human-Readable, Rolling) -->
    <appender name="FILE_PLAIN" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/college-app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/college-app.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{correlationId:-NO-CORRELATION-ID}] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- FILE APPENDER for PROD (JSON Structured, Rolling) -->
    <appender name="FILE_JSON" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/college-app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/college-app.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <timeZone>UTC</timeZone>
            <includeMdc>true</includeMdc>
            <includeMdcKeyName>mdc</includeMdcKeyName>
        </encoder>
    </appender>
    
    <!-- Profile: local, dev (default) - Human-Readable Logs -->
    <springProfile name="local,dev,default">
        <root level="INFO">
            <appender-ref ref="CONSOLE_PLAIN"/>
            <appender-ref ref="FILE_PLAIN"/>
        </root>
        <logger name="com.aahzi.collegedata" level="DEBUG"/>
    </springProfile>
    
    <!-- Profile: prod, staging - JSON Structured Logs -->
    <springProfile name="prod,staging">
        <root level="INFO">
            <appender-ref ref="CONSOLE_JSON"/>
            <appender-ref ref="FILE_JSON"/>
        </root>
        <logger name="com.aahzi.collegedata" level="INFO"/>
    </springProfile>
    
</configuration>
